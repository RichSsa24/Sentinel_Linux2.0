# Settings for the systemd unit (deploy/systemd/sentinel.service). Install it
# owner-only, then set the API key:
#   sudo install -m 0600 deploy/systemd/sentinel.env.example /etc/sentinel/sentinel.env
#
# The unit already points SENTINEL_DATABASE_URL at SQLite under
# /var/lib/sentinel and SENTINEL_RULES_DIR at /opt/sentinel/rules. A value set
# here overrides the unit's, so set them only on purpose (PostgreSQL, below).
# Every other SENTINEL_* variable is documented in the repository's .env.example.

SENTINEL_ENV=production

# 32+ characters; generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=

SENTINEL_LOG_FORMAT=json

# To use PostgreSQL instead of the unit's SQLite file:
# SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:<password>@db.example:5432/sentinel

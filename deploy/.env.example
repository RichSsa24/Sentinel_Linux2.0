# Copy to deploy/.env (git-ignored) and set every value. Compose refuses to
# start while any of them is missing. Use URL-safe values (the database password
# is embedded in a connection URL), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Bearer key for the Sentinel API; Prometheus scrapes /metrics with it too.
SENTINEL_API_KEY=
# PostgreSQL superuser (`postgres`) password — administration and backups
# only; Sentinel never receives it.
POSTGRES_PASSWORD=
# Password of the `sentinel` role Sentinel connects as: it owns the sentinel
# database and nothing else (created on the volume's first start).
POSTGRES_APP_PASSWORD=
# Grafana `admin` password.
GRAFANA_ADMIN_PASSWORD=

# Optional: host paths watched for file integrity (default /etc). Each one
# must also be mounted under /host in docker-compose.yml.
# SENTINEL_FIM_PATHS=/etc

# Other optional Sentinel tuning (webhook/email sinks, alert gates, retention,
# ...) goes in deploy/sentinel.env — see the repository's .env.example for
# every SENTINEL_* variable.

# Sentinel-Linux 2.0 — environment template for local (non-Docker) runs.
# Copy to `.env` (git-ignored) and fill in real values. For the Compose stack,
# use `deploy/.env.example` instead.
#
# Every variable maps 1:1 onto a field of `sentinel.settings.Settings`.
# Unknown `SENTINEL_*` variables are a startup error (a typo must never
# silently disable a control), and `tests/test_env_examples.py` keeps this
# file in sync with the code.

# --- Required ---------------------------------------------------------------

# Deployment environment: development | test | production. No default.
SENTINEL_ENV=development

# Bearer key for the read API, at least 32 characters. Unset = the API refuses
# every data request (fail-closed). This placeholder is rejected at startup.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=replace-with-a-long-random-token  # pragma: allowlist secret

# --- Logging ----------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
SENTINEL_LOG_LEVEL=INFO
# json (SIEM ingest, production) | console (human-readable)
SENTINEL_LOG_FORMAT=console

# --- Persistence ------------------------------------------------------------

# Async SQLAlchemy URL. SQLite by default; PostgreSQL e.g.
# postgresql+asyncpg://sentinel:<password>@localhost:5432/sentinel
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# Events are written in batches: whichever comes first, N events or T seconds.
# SENTINEL_PERSIST_BATCH_SIZE=256
# SENTINEL_PERSIST_FLUSH_INTERVAL_SECONDS=0.5
# Records kept for retry during a database outage (oldest dropped beyond this).
# SENTINEL_PERSIST_MAX_BUFFERED=10000
# A batch write that takes longer than this fails and is retried.
# SENTINEL_PERSIST_WRITE_TIMEOUT_SECONDS=10

# --- Collectors & rules (defaults shown) ------------------------------------

# Which collectors run: any of auth-log,file-integrity,process,network.
# SENTINEL_COLLECTORS=auth-log,file-integrity,process,network
# Where the host filesystem is visible: "/" on bare metal, "/host" in Docker.
# SENTINEL_HOST_ROOT=/
# host.name on events; default: <host_root>/etc/hostname, else the local hostname.
# SENTINEL_HOST_NAME=web01
# Host-native paths (resolved beneath SENTINEL_HOST_ROOT).
# SENTINEL_AUTH_LOG_PATH=/var/log/auth.log
# Add /var/log to enable log-tampering (busy: every append is a change).
# SENTINEL_FIM_PATHS=/etc,/var/spool/cron
# SENTINEL_RULES_DIR=rules

# --- Pipeline (defaults shown) ----------------------------------------------

# SENTINEL_QUEUE_MAXSIZE=10000
# SENTINEL_QUEUE_BACKPRESSURE=block            # block | drop_newest
# SENTINEL_DEDUP_WINDOW_SECONDS=60
# SENTINEL_DEDUP_MAX_ENTRIES=100000

# --- Alerting gates (defaults shown) ----------------------------------------

# SENTINEL_ALERT_MIN_SEVERITY=0
# SENTINEL_ALERT_DEDUP_WINDOW_SECONDS=300
# SENTINEL_ALERT_THROTTLE_MAX=10
# SENTINEL_ALERT_THROTTLE_WINDOW_SECONDS=60

# --- Webhook sink (optional; enabled when URL + secret are set) -------------

# https only; checked at startup and resolved + checked on every send. Proxy
# variables (HTTPS_PROXY) are deliberately ignored by the webhook client.
# SENTINEL_WEBHOOK_URL=https://hooks.example.com/sentinel
# At least 32 characters.
# SENTINEL_WEBHOOK_HMAC_SECRET=replace-with-a-32-character-or-longer-secret
# SENTINEL_WEBHOOK_ALLOW_PRIVATE=false

# --- Email sink (optional; enabled when host, sender and recipients are set) -

# SENTINEL_SMTP_HOST=smtp.example.com
# SENTINEL_SMTP_PORT=587
# SENTINEL_SMTP_USERNAME=alerts@example.com
# SENTINEL_SMTP_PASSWORD=replace-me
# SENTINEL_SMTP_STARTTLS=true
# SENTINEL_EMAIL_FROM=sentinel@example.com
# SENTINEL_EMAIL_RECIPIENTS=soc@example.com,oncall@example.com

# --- Read API (defaults shown) ----------------------------------------------

# SENTINEL_API_CORS_ORIGINS=                    # comma-separated exact origins
# SENTINEL_API_RATE_LIMIT=100
# SENTINEL_API_RATE_WINDOW_SECONDS=60
# SENTINEL_API_MAX_PAGE_SIZE=100
